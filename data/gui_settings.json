{
  "ai_provider": "ollama",
  "ollama_model": "llama3.2:3b",
  "ollama_base_url": "http://127.0.0.1:11434",
  "api_base_url": "https://api.openai.com",
  "api_key_env": "OPENAI_API_KEY",
  "api_model": "gpt-4o-mini",
  "auto_summary_default": false,
  "summary_segment_limit": 120,
  "summary_instructions_path": "",
  "default_worker_count": 6,
  "default_downloaders": 6,
  "default_transcribers": 1,
  "job_retry_limit": 1,
  "auto_transcribe_default": true,
  "subscription_db_max_videos": 0,
  "theme_bg": "#333333",
  "theme_panel_bg": "#000000",
  "theme_surface_bg": "#000000",
  "theme_surface_alt_bg": "#000000",
  "theme_border": "#000000",
  "theme_select_bg": "#0000aa",
  "theme_fg": "#ffffff",
  "theme_soft_fg": "#d2d2d2",
  "theme_muted_fg": "#8f8f8f",
  "theme_accent_fg": "#00ffff",
  "theme_info_fg": "#7fd7ff",
  "theme_idle_fg": "#39d5ff",
  "theme_error_fg": "#ff8a8a",
  "theme_log_fg": "#b0b0b0",
  "theme_selected_bg": "#282828",
  "theme_video_overlay_bg": "#111111",
  "theme_video_overlay_fg": "#ffffff",
  "font_family": "Blexmono Nerd Font",
  "font_size": 9,
  "show_root_top_bar": true,
  "show_launch_bar": true,
  "show_popup_top_bar": true,
  "keybinds": {
    "open_command": "Ctrl+P",
    "open_ingest": "Ctrl+N",
    "open_workers": "Ctrl+I",
    "open_video": "Ctrl+O",
    "open_finder": "Ctrl+F",
    "open_ai": "Ctrl+A",
    "open_goto": "Ctrl+G",
    "toggle_skim": "Ctrl+S",
    "open_settings": "Ctrl+M",
    "quit": "Ctrl+Q",
    "play_pause": "Ctrl+Space",
    "seek_back": "Ctrl+Left",
    "seek_forward": "Ctrl+Right",
    "prev_match": "Ctrl+Up",
    "next_match": "Ctrl+Down",
    "vim_left": "Ctrl+H",
    "vim_down": "Ctrl+J",
    "vim_up": "Ctrl+K",
    "vim_right": "Ctrl+L",
    "clear_input": "Ctrl+C",
    "toggle_transcript": "Ctrl+T",
    "toggle_details": "Ctrl+D"
  }
}